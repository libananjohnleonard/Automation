{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",

    "moduleResolution": "nodenext",

    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
